APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
FRONTEND_URL=http://localhost:3000
# Comma-separated origins for CORS (e.g. https://app.example.com). Dev defaults include localhost:3000–3002.
# CORS_ALLOWED_ORIGINS=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=pusher
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https

# M-Pesa (Safaricom Daraja). Leave empty to skip STK Push.
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_BASE_URL="${APP_URL}"
MPESA_ENVIRONMENT=sandbox

# Tumizi Partner API. Sandbox is the default; production uses api.tumizi.africa.
TUMIZI_BASE_URL=https://api.sandbox.tumizi.africa/api/partner/v1
TUMIZI_API_KEY=
TUMIZI_WEBHOOK_SECRET=
TUMIZI_WEBHOOK_TOLERANCE=300
TUMIZI_TIMEOUT=20

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# Use "predis" if the PHP Redis extension is not loaded (e.g. Valet using different PHP); use "phpredis" for best performance when the extension is available
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=resend
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
RESEND_KEY=

# PDF line-numbering engine and diagnostics
PDF_LINE_EXTRACTOR_ENGINE=auto
PDF_LINE_POPPLER_BINARY=pdftotext
PDF_LINE_QPDF_BINARY=qpdf
PDF_LINE_POPPLER_BASELINE_RATIO=0.78
PDF_LINE_Y_TOLERANCE_PT=3
PDF_LINE_NUMBER_INSET_PT=3
PDF_LINE_PAGE_EDGE_PADDING_PT=6
PDF_LINE_LABEL_WIDTH_FACTOR=0.56
PDF_LINE_ENABLE_DIAGNOSTICS=true
PDF_LINE_DEBUG_OVERLAY=false

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# PaddleOCR — replaces Textract
PADDLEOCR_ENABLED=false
PADDLEOCR_URL=http://127.0.0.1:8765
# Multiple sidecar instances (paddle-ocr-service/run.sh N) for parallel pages
PADDLEOCR_URLS=http://127.0.0.1:8765,http://127.0.0.1:8766
PADDLEOCR_TIMEOUT_SECONDS=180
PADDLEOCR_MIN_CONFIDENCE=0.0
PADDLEOCR_RENDER_DPI=300
# Pages OCR'd concurrently; match the sidecar's `uvicorn --workers N`
PADDLEOCR_CONCURRENCY=2
# ~0.2 = font baseline sits at descender height above the OCR box bottom,
# which puts the -N label exactly on its line (higher values float it upward)
PADDLEOCR_BASELINE_RATIO=0.20
# Row clustering: collapse OCR fragments that share a visual row into one line
PADDLEOCR_ROW_CLUSTER_ENABLED=true
PADDLEOCR_ROW_CLUSTER_OVERLAP_RATIO=0.35
PADDLEOCR_ROW_CLUSTER_BASELINE_FACTOR=0.5
PADDLEOCR_ROW_SPLIT_HEIGHT_FACTOR=1.7
# Text-lines-only numbering: do not insert synthetic anchors for blank gaps
PDF_LINE_ENABLE_OCR_GRID_RECONSTRUCTION=false
# Keep low-confidence body lines on OCR pages so counts don't drift
PDF_LINE_OCR_KEEP_LOW_CONFIDENCE_BODY_LINES=true

VITE_APP_NAME="${APP_NAME}"
